# GOOGLE_SHEET_WEBAPP_URL — URL веб-приложения Google Apps Script,
# которое дописывает строки в таблицу:
# https://docs.google.com/spreadsheets/d/1WCVJwD-6lRwfQminRV_yWIPxm_rTAmMjWr2oNnr3Pn4/edit
#
# Если переменная не задана, ответы всё равно сохраняются в PostgreSQL
# и остаются доступны на странице /responses (оттуда их можно скопировать
# или выгрузить CSV).
# GOOGLE_SHEET_WEBAPP_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Необязательный ключ доступа к странице /responses.
# Если задан, страница доступна только по адресу /responses?key=ВАШ_КЛЮЧ
# ADMIN_TOKEN=super-secret-key

# Адрес сайта — используется для абсолютных ссылок в og:image
# (картинка-превью при пересылке ссылки в мессенджерах).
# Укажите домен, который выдаст Amvera после деплоя.
NEXT_PUBLIC_SITE_URL=https://your-project-username.amvera.ru
